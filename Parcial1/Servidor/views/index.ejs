<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Usuarios</title>
  </head>
  <body>
    <main>
      <h1>Usuarios</h1>

      <% if (users.length === 0) { %>
        <p>No hay usuarios registrados.</p>
      <% } else { %>
        <ul>
          <% users.forEach((user) => { %>
            <li><strong><%= user.id %></strong> - <%= user.name %></li>
          <% }) %>
        </ul>
      <% } %>
    </main>
  </body>
</html>
