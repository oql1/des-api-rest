PORT=3000

# Usuario/clave para el inicio de sesión JWT
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password

# Opcional: si no se definen, Basic reutiliza AUTH_USERNAME y AUTH_PASSWORD
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-this-basic-password

# Genera una clave aleatoria de al menos 32 caracteres
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Clave enviada en el encabezado X-API-Key
API_KEY=replace-with-a-long-random-api-key

# Token estático enviado como Authorization: Bearer <token>
BEARER_TOKEN=replace-with-a-long-random-bearer-token
